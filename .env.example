# Create a key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Leave blank to discard telemetry locally. Set to 1 to export to Dash0.
OTEL_ENABLED=

# Required when OTEL_ENABLED=1.
# Copy the endpoint and auth token from your Dash0 organization settings.
DASH0_OTLP_ENDPOINT=
DASH0_AUTH_TOKEN=
DASH0_DATASET=default
OTEL_COLLECTOR_LOG_LEVEL=debug
OTEL_DEBUG_VERBOSITY=basic
