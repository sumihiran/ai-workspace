{
  "name": "java-ai-workspace",
  "dockerComposeFile": "../../compose.yaml",
  "service": "java",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  }
}
